#Create new variables (windspeed in km/h and temperature in C)
bikes$windspeed_KmH<-(bikes$windspeed*1.609)
bikes$min_temperature_celcius<-((bikes$min_temperature-32)*(5/9))
#convert date variables to a date
bikes$date<-as.Date(bikes$date)


#Create a simple regression for bikes ~ temperature called mod1
mod1<-lm(formula=bikes$count~bikes$min_temperature_celcius, data=bikes)
summary(mod1)
coef(mod1)
coef(mod1)[1] #Lists the coefficients found in mod1 (regression 1)
coef(mod1)[2] #can be used to call coefficients

# according to summary (mod1) βˆ0 (intercept) = 51409 and βˆ1 (slope)=2665. 
# The effect of temperature is statistically significant p<0.05. However R^2 = 0,28.
# 28% of variance in bike count is explained by temperature.

#scatterplot
plot(x =bikes$min_temperature_celcius, y =bikes$count, pch = 20,
     col = adjustcolor("pink", alpha.f = 0.7),
     xlab = "Temperature Celsius", ylab = "bike count")
abline(a = coef(mod1)[1], b = coef(mod1)[2], lwd = 2, col="red") #a=intecept, b=slope


#2.3 MODEL CHECKING, see if regression fulfills assumptions:
#DISTRIBUTION OF RESIDUALS          #NOT NORMALLY DISTRIBUTED, SHIFTED TO LEFT
res <- residuals(mod1)
hist(res, breaks = 30, probability = TRUE, col = "grey",
     border = "white", main = "", xlab = "residuals", ylab = "density")
curve(dnorm(x, mean = mean(res), sd = sd(res)), add = TRUE, lwd = 2) #"ADD=TRUE makes the curve be added to the histogram

#QUANTILE-QUANTILE (QQ-PLOT) - residuals are normal
#Residuals are not normally distributed (S-SHAPE), do not fulfill assumption
qqnorm(res, pch = 20, main = "",
       xlab = "theoretical quantiles", ylab = "sample quantiles")
qqline(res, lwd = 2)

#Residuals against covariate
#Not evenly distributed (clustered at top)
x <- bikes$min_temperature_celcius[!is.na(bikes$min_temperature_celcius)&!is.na(bikes$count)]# without NAs
plot(x = x, y = res, pch = 20, col = adjustcolor("lightblue", alpha.f = 0.3), xlab = "Temperature C",ylab = "residuals")
abline(h = 0, lty = 2) # horizontal line at 0
length(x)
length(res)

