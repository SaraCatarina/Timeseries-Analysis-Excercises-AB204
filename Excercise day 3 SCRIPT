setwd("C:/Users/teafr/OneDrive - NTNU/Skrivbordet/AB-204")
bikes<-read.csv("bike_sharing.csv")

#make quadratic formula for bikes data:
bikes$t <- 1:nrow(bikes)
mod_5 <- lm(formula = count ~ t + I(t^2), data = bikes)
summary(mod_5)


#2.2 make acf() and residuals() functions for mod_5
res<-residuals(mod_5)
acf(res, lag.max = 365, ci.col = "black",
    main = "", xlab = "lag", ylab = "ACF")
    #plot shows= The residuals are not independent:because close residuals have similar value
                #this means that there are seasonal effects


#2.3 add seasonal component
mod_6 <- lm(formula = count ~ t + I(t^2) + sin(2 * pi * day_of_year / 365)
                 + cos(2 * pi * day_of_year / 365), data = bikes)
summary(mod_6)


#2.4 time series plot for bikes count + fitted values from mod_6
bikes$date <- as.Date(bikes$date, format = "%Y-%m-%d")
plot(x = bikes$date, y = bikes$count, type = "b", cex = 0.3, col = "grey",
    xlab = "year", ylab = "number of bikes")
lines(x = bikes$date, y = predict(mod_6, newdata = bikes), lwd = 2)


#2.5 plot ACF and resiguals for mod_6
res_1<-residuals(mod_6)
acf(res_1, lag.max = 365, ci.col = "green",
    main = "", xlab = "lag", ylab = "ACF")
    #Looks better, the residuals are more evenly distributed, not as big cyclical effect anymore


