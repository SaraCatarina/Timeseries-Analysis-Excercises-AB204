#KERNEL DENSITY ESTIMATE
dens <- density(x = bikes$count, na.rm = TRUE)
plot(dens, lwd = 2, xlab = "number of bikes", ylab = "density", main = "")
polygon(dens, col = adjustcolor("pink", alpha.f = 0.5), border = NA) 

hist(x = bikes$count, breaks = 40, probability = TRUE, main = "",
     col = "maroon", border = "white",
     xlab = "count", ylab = "density")
lines(dens, lwd = 2)

dens_dry <- density(subset(bikes_2025,precipitation==0)$count)
dens_rainy <- density(subset(bikes_2025,precipitation>0)$count)
plot(dens_dry, col="red",lwd=2,main="")
lines(dens_rainy,col="blue",lwd=2)
legend("topleft",legend=c("dry","rainy"),col="red",lwd=2)

